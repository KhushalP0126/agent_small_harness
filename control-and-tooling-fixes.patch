+import unittest
+from dataclasses import dataclass
+
+from engines.base import EngineFinding
+from harness_kernel.tool_handlers import (
+    ExecutionRequest,
+    LintRequest,
+    LintResult,
+    build_default_tool_registry,
+)
+from harness_kernel.tool_registry import ToolError, ToolHandler, ToolRegistry
+from validation.behavior import BehaviorCase, FunctionBehaviorSpec
+
+
+@dataclass(frozen=True)
+class _EchoRequest:
+    value: int
+
+
+@dataclass(frozen=True)
+class _EchoResponse:
+    value: int
+
+
+class ToolRegistryTests(unittest.TestCase):
+    def test_dispatch_success_returns_ok_result(self) -> None:
+        registry = ToolRegistry()
+        registry.register(
+            ToolHandler(
+                name="echo",
+                request_type=_EchoRequest,
+                response_type=_EchoResponse,
+                invoke=lambda request: _EchoResponse(value=request.value + 1),
+            )
+        )
+        result = registry.dispatch("echo", _EchoRequest(value=1))
+        self.assertTrue(result.ok)
+        self.assertEqual(result.value, _EchoResponse(value=2))
+        self.assertEqual(result.tool, "echo")
+
+    def test_dispatch_unknown_tool_fails_without_raising(self) -> None:
+        registry = ToolRegistry()
+        result = registry.dispatch("does_not_exist", _EchoRequest(value=1))
+        self.assertFalse(result.ok)
+        self.assertEqual(result.error_kind, "unknown_tool")
+
+    def test_dispatch_wrong_request_type_fails_without_raising(self) -> None:
+        registry = ToolRegistry()
+        registry.register(
+            ToolHandler(
+                name="echo",
+                request_type=_EchoRequest,
+                response_type=_EchoResponse,
+                invoke=lambda request: _EchoResponse(value=request.value),
+            )
+        )
+        result = registry.dispatch("echo", "not a request")
+        self.assertFalse(result.ok)
+        self.assertEqual(result.error_kind, "invalid_request_type")
+
+    def test_handler_exception_is_caught_into_failed_result(self) -> None:
+        registry = ToolRegistry()
+
+        def boom(_request: _EchoRequest) -> _EchoResponse:
+            raise RuntimeError("kaboom")
+
+        registry.register(
+            ToolHandler(
+                name="echo",
+                request_type=_EchoRequest,
+                response_type=_EchoResponse,
+                invoke=boom,
+            )
+        )
+        result = registry.dispatch("echo", _EchoRequest(value=1))
+        self.assertFalse(result.ok)
+        self.assertEqual(result.error_kind, "handler_exception")
+        self.assertIn("kaboom", result.error)
+
+    def test_typed_tool_error_preserves_kind(self) -> None:
+        registry = ToolRegistry()
+
+        def boom(_request: _EchoRequest) -> _EchoResponse:
+            raise ToolError("bad input", kind="validation_failed")
+
+        registry.register(
+            ToolHandler(
+                name="echo",
+                request_type=_EchoRequest,
+                response_type=_EchoResponse,
+                invoke=boom,
+            )
+        )
+        result = registry.dispatch("echo", _EchoRequest(value=1))
+        self.assertFalse(result.ok)
+        self.assertEqual(result.error_kind, "validation_failed")
+
+    def test_duplicate_registration_rejected(self) -> None:
+        registry = ToolRegistry()
+        handler = ToolHandler(
+            name="echo",
+            request_type=_EchoRequest,
+            response_type=_EchoResponse,
+            invoke=lambda request: _EchoResponse(value=request.value),
+        )
+        registry.register(handler)
+        with self.assertRaises(ValueError):
+            registry.register(handler)
+
+    def test_known_tools_lists_registered_names(self) -> None:
+        registry = ToolRegistry()
+        registry.register(
+            ToolHandler(
+                name="b_tool",
+                request_type=_EchoRequest,
+                response_type=_EchoResponse,
+                invoke=lambda request: _EchoResponse(value=request.value),
+            )
+        )
+        registry.register(
+            ToolHandler(
+                name="a_tool",
+                request_type=_EchoRequest,
+                response_type=_EchoResponse,
+                invoke=lambda request: _EchoResponse(value=request.value),
+            )
+        )
+        self.assertEqual(registry.known_tools(), ["a_tool", "b_tool"])
+
+
+class DefaultToolRegistryTests(unittest.TestCase):
+    def test_lint_tool_dispatches_and_returns_findings(self) -> None:
+        registry = build_default_tool_registry()
+        result = registry.dispatch("lint", LintRequest(source="x = 1\n"))
+        self.assertTrue(result.ok)
+        self.assertIsInstance(result.value, LintResult)
+        self.assertIsInstance(result.value.findings[0], EngineFinding)
+
+    def test_execution_sandbox_tool_dispatches_and_returns_trace(self) -> None:
+        spec = FunctionBehaviorSpec(
+            function_name="add",
+            cases=[BehaviorCase(name="basic", args=(2, 3), kwargs={}, expected=5)],
+        )
+        registry = build_default_tool_registry()
+        result = registry.dispatch(
+            "execution_sandbox",
+            ExecutionRequest(source="def add(a, b):\n    return a + b\n", spec=spec),
+        )
+        self.assertTrue(result.ok)
+        self.assertEqual(result.value.function_name, "add")
+        self.assertTrue(result.value.cases[0].matched)
+
+    def test_execution_sandbox_tool_reports_mismatch_without_raising(self) -> None:
+        spec = FunctionBehaviorSpec(
+            function_name="add",
+            cases=[BehaviorCase(name="basic", args=(2, 3), kwargs={}, expected=5)],
+        )
+        registry = build_default_tool_registry()
+        result = registry.dispatch(
+            "execution_sandbox",
+            ExecutionRequest(source="def add(a, b):\n    return a - b\n", spec=spec),
+        )
+        self.assertTrue(result.ok)
+        self.assertFalse(result.value.cases[0].matched)
+
+
+if __name__ == "__main__":
+    unittest.main()
