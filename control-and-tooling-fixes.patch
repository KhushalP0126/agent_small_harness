+    def test_contract_queue_isolates_independent_contract_failure(self) -> None:
+        plan = PlanModeAgent().plan("")
+        queue = ContractQueue(
+            [
+                FunctionContract(
+                    name="doomed",
+                    signature="def doomed() -> int",
+                    examples=[DealExample("doomed()", "1")],
+                ),
+                FunctionContract(
+                    name="independent",
+                    signature="def independent() -> int",
+                    examples=[DealExample("independent()", "5")],
+                ),
+                FunctionContract(
+                    name="depends_on_doomed",
+                    signature="def depends_on_doomed() -> int",
+                    dependencies=["doomed"],
+                ),
+            ]
+        )
+        calls = []
+
+        def generate(prompt: str) -> str:
+            if "NAME: doomed" in prompt:
+                calls.append("generate:doomed")
+                # Never satisfies its example; will exhaust retries and fail.
+                return "def doomed() -> int:\n    return 0\n"
+            if "NAME: independent" in prompt:
+                calls.append("generate:independent")
+                return "def independent() -> int:\n    return 5\n"
+            raise AssertionError(f"unexpected prompt for: {prompt[:80]}")
+
+        def repair(draft: str, prompt: str) -> str:
+            calls.append("repair:doomed")
+            # Repair keeps failing on purpose to simulate an unfixable contract.
+            return "def doomed() -> int:\n    return -1\n"
+
+        accepted_sources, results = _run_contract_queue_sequentially(
+            queue,
+            plan,
+            generate,
+            repair_draft=repair,
+            small_retries_per_contract=1,
+        )
+
+        results_by_name = {result.name: result for result in results}
+        # The independent contract must still be attempted and accepted even
+        # though `doomed` (which it does not depend on) failed permanently.
+        self.assertEqual(results_by_name["doomed"].status, "validation_failed")
+        self.assertEqual(results_by_name["independent"].status, "accepted")
+        self.assertIn("def independent", "\n".join(accepted_sources))
+        # The contract that genuinely depends on the failed one must be
+        # reported as blocked rather than silently dropped or attempted.
+        blocked_result = next(
+            (result for result in results if result.status == "dependency_blocked"),
+            None,
+        )
+        self.assertIsNotNone(blocked_result)
+        self.assertIn("depends_on_doomed", blocked_result.issues[0]["details"])
+
