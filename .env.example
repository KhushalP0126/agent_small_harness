# Copy this file to .env and fill in one API key locally.
# .env is ignored by git.
#
# Preferred generic architect key name:
ARCHITECT_API_KEY=
#
# DeepSeek-specific fallback key name:
DEEPSEEK_API_KEY=

# Optional overrides:
# ARCHITECT_MODEL=deepseek-v4-pro
# ARCHITECT_API_BASE_URL=https://api.deepseek.com/chat/completions
# ARCHITECT_MAX_TOKENS=4000
# ARCHITECT_RETRY_ATTEMPTS=3
# ARCHITECT_RETRY_BACKOFF_SECONDS=0.5
# KERNEL_API_KEY=
