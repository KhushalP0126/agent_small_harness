# Copy this file to .env and fill in one API key locally.
# .env is ignored by git.
#
# Preferred generic architect key name:
ARCHITECT_API_KEY=
#
# DeepSeek-specific fallback key name:
DEEPSEEK_API_KEY=

# Interactive chat, planning, and repository tools use the configured API.
# Retained for backwards-compatible configuration files.
HARNESS_ARCHITECT_MODE=api
# Keep the small local model resident only briefly for scaffolding/GitHub chores.
OLLAMA_KEEP_ALIVE=30s
# The interactive TUI leaves engine checks off until they are explicitly needed.
HARNESS_ENGINES_ENABLED=0
# ARCHITECT_MODEL=deepseek-v4-pro
# ARCHITECT_API_BASE_URL=https://api.deepseek.com/chat/completions
# Interactive DeepSeek calls use the repair profile below by default. These
# optional overrides are shown explicitly so a local .env cannot accidentally
# disable reasoning or truncate coding/tool-use responses.
ARCHITECT_MAX_TOKENS=8000
ARCHITECT_THINKING_TYPE=enabled
ARCHITECT_REASONING_EFFORT=high
# ARCHITECT_RETRY_ATTEMPTS=3
# ARCHITECT_RETRY_BACKOFF_SECONDS=0.5
# KERNEL_API_KEY=
